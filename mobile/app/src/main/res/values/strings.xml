    <string name="guide_title">Connection guide</string>
    <string name="guide_subtitle">Pick one of the two paths and follow the steps</string>
    <string name="guide_usb">USB cable</string>
    <string name="guide_hotspot">Wi‑Fi hotspot</string>
    <string name="guide_usb_1">1. Plug the USB cable between phone and PC.</string>
    <string name="guide_usb_2">2. Turn on USB tethering in phone settings.</string>
    <string name="guide_usb_3">3. Turn on your VPN (All-apps mode).</string>
    <string name="guide_usb_4">4. Keep this app open with sharing on.</string>
    <string name="guide_usb_5">5. Typical phone IP: 192.168.42.129</string>
    <string name="guide_usb_6">6. Desktop app: scan → 6-digit code → Connect.</string>
    <string name="guide_hotspot_1">1. Turn on the phone hotspot (WPA2 password).</string>
    <string name="guide_hotspot_2">2. Join that hotspot from the PC.</string>
    <string name="guide_hotspot_3">3. Turn on your VPN (All-apps mode).</string>
    <string name="guide_hotspot_4">4. Keep this app open with sharing on.</string>
    <string name="guide_hotspot_5">5. Typical phone IP: 192.168.43.1</string>
    <string name="guide_hotspot_6">6. Desktop app: scan → 6-digit code → Connect.</string>
    <string name="guide_note">Plugging the cable alone is not enough — USB tethering must be ON.</string>
